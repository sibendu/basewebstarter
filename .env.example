# Next.js config
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-change-this-in-production

# Local login
ALLOW_LOCAL_PASSWORD_LOGIN=true
AUTH_USER=admin
AUTH_PASSWORD=admin

## PostgreSQL
DB_PROVIDER=postgresql
DATABASE_URL=postgresql://postgres:aisdlc@localhost:5432/<database_sid>
DB_BOOTSTRAP_ON_START=false
DB_SEED_ON_START=false

# Azure Account - SSO Login uses this service principal
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_REDIRECT_URI=http://localhost:3000/api/auth/azure/callback

# External API Clients use this App registration
EXTERNAL_API_TENANT_ID=
EXTERNAL_API_CLIENT_ID=
EXTERNAL_API_ALLOWED_CLIENT_IDS=

# Shared signing key for local and Azure UI sessions.
EINVOICE_SESSION_SECRET=53b1b37ad2f2c85fcc2f7f498971757b97b97f33a4b100eb8dbe9cbcd8bc217a
